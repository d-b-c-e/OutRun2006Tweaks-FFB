# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

build/*
build_x86/*
.vscode/*
out/*
.vs/*
rel/*

# Vendored dbce-wheel-mod-toolkit artifacts are committed on purpose: a consumer
# pins a BUILT version (lib/toolkit/VERSION) rather than referencing the toolkit
# repo, so a toolkit change never reaches the game without a diffable bump.
!lib/toolkit/native/**/*.dll
